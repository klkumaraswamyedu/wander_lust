<% layout('/layouts/boilerplate') %>

<body>
  <div class="card mb-3 col-8">
    <img src="<%= list.image.url %>" class="card-img-top" alt="list image" style="width: 18rem" />
  </div>

  <div class="id-info">
    <h3>
      welcome to <u><i><%= list.title %></i></u>
    </h3>
    <p><%= list.description %></p>
    <p>&#8377; <%= list.price.toLocaleString('en-IN') %> / night-</p>
    <p><%= list.location %></p>
    <p><%= list.country %></p>
    <br />
  </div>

  <div class="list-features">
    <form action="/listing/<%= list._id %>/edit" method="get">
      <button class="btn">
        <i class="fa-regular fa-pen-to-square"></i>EDIT
      </button>
    </form>
    <form action="/listing/<%= list._id %>?_method=DELETE" method="post">
      <button class="btn"><i class="fa-solid fa-trash"></i>DELETE</button>
    </form>
  </div>
  <hr />

  <h4>All review</h4>
  <div class="show-reviews row">
    <% for(let review of list.reviews) { %>
    <div class="card-body border border-2 col-4 m-2 rounded">
      <p class="card-text p-2"><%= review.comment %> ,<%= review.rating %><i class="fa-solid fa-star"></i></p>
      <form action="/listing/<%= list._id %>/review/<%= review._id %>?_method=DELETE" method="post">
        <button class="btn btn-sm btn-dark">Delete</button>
      </form>
    </div>
    <% } %>
  </div>

  <div class="review row">
    <form action="/listing/<%= list._id %>/review" method="post" novalidate class="needs-validation">
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label><br />
        <input type="range" class="form-range" name="review[rating]" step="1" min="1" max="5" />
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment</label><br />
        <textarea name="review[comment]" placeholder="Review here..." class="form-control" rows="3" cols="40" required></textarea>
        <div class="invalid-feedback">Add review!!!</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
  </div>
</body>